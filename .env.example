# Supply these through environment variables or a gitignored appsettings.Development.json.
ConnectionStrings__Payments=Server=localhost;Port=3306;Database=payment_db;User ID=payment_svc;Password=replace-me;SslMode=Required
Identity__BaseUrl=https://localhost:7136
InternalServices__ApiKey=replace-with-shared-internal-service-key
ASPNETCORE_URLS=http://localhost:8083
Kafka__Enabled=false
Kafka__BootstrapServers=localhost:9092
Kafka__TripEventsTopic=goride.trip.events
Kafka__GroupId=goride-payment
# PayHere checkout is sandbox-only (https://sandbox.payhere.lk). Never put the secret in frontend code.
PayHere__MerchantId=replace-with-your-sandbox-merchant-id
PayHere__MerchantSecret=replace-with-your-sandbox-merchant-secret
PayHere__ReturnUrl=http://localhost:8083/dev/payments?result=return
PayHere__CancelUrl=http://localhost:8083/dev/payments?result=cancel
# PayHere cannot reach localhost; use a public HTTPS tunnel URL to receive real sandbox notifications.
PayHere__NotifyUrl=http://localhost:8083/payments/payhere/notify
DevelopmentCheckout__Enabled=false
